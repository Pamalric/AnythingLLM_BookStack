{
  "name": "bookstack-anythingllm-sync",
  "private": true,
  "version": "0.1.0",
  "description": "Connecteur BookStack → AnythingLLM (BookStack Sync) pour XPERTEAM",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @bookstack-sync/web build && pnpm --filter @bookstack-sync/api build",
    "dev": "pnpm --filter @bookstack-sync/api dev",
    "dev:web": "pnpm --filter @bookstack-sync/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "start": "pnpm --filter @bookstack-sync/api start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
