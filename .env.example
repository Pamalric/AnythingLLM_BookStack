# BookStack Sync — exemple d'environnement (AUCUN secret réel)
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# SQLite dédiée au connecteur (hors volume Jarvis)
# Chemin relatif au dossier prisma/ (schéma Prisma)
DATABASE_URL=file:../data/bookstack-sync.db

# Auth console admin locale (lot 1)
# Mot de passe fourni en clair UNIQUEMENT au bootstrap ; stocké hashé Argon2id ensuite.
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=administrator
# Ou hash pré-calculé (prioritaire si défini) :
# ADMIN_PASSWORD_HASH=

# Secret de signature des cookies de session (min 32 caractères aléatoires)
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origines autorisées (SSRF / CORS) — hosts uniquement
ALLOWED_BOOKSTACK_HOSTS=documentation.xperteam.net
ALLOWED_ANYTHINGLLM_HOSTS=jarvis.xperteam.net,anythingllm

# URL publiques suggérées (non secrètes)
BOOKSTACK_BASE_URL=https://documentation.xperteam.net
ANYTHINGLLM_BASE_URL=https://jarvis.xperteam.net

# Secrets API — injectés via env/Docker secrets, jamais commités
# BOOKSTACK_TOKEN_ID=
# BOOKSTACK_TOKEN_SECRET=
# ANYTHINGLLM_API_KEY=

# Coffre chiffré (AES-256-GCM) pour secrets saisis via la console — clé HORS SQLite
# SECRETS_MASTER_KEY=une-cle-longue-aleatoire
# SECRETS_FILE=data/secrets.enc

# Timezone scheduler (lots suivants)
TZ=Europe/Paris
