# BookStack Sync — exemple d'environnement (AUCUN secret réel)
# Doc détaillée : docs/operations.md §3

# development | test | production — en VPS : production (cookies Secure, Helmet)
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# SQLite dédiée au connecteur (hors volume Jarvis)
# Chemin relatif au dossier prisma/ (schéma Prisma)
# En Docker Compose : file:/app/data/bookstack-sync.db (écrasé par compose.yaml)
DATABASE_URL=file:../data/bookstack-sync.db

# --- Auth console ---
ADMIN_USERNAME=administrator
# Dev : mot de passe en clair (hashé Argon2id au démarrage, warning en log).
# Prod : préférer ADMIN_PASSWORD_HASH et retirer ADMIN_PASSWORD.
ADMIN_PASSWORD=administrator
# ADMIN_PASSWORD_HASH=

# HMAC cookies de session — OBLIGATOIRE ≥ 32 car. aléatoires
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min

# Cookies : true derrière HTTPS/Traefik ; false en HTTP local
# (en NODE_ENV=production, Secure est forcé même si false)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowlist SSRF — hosts uniquement (virgules, sans https://)
ALLOWED_BOOKSTACK_HOSTS=documentation.xperteam.net
# Public Jarvis + hostname Docker interne (réseau proxy)
ALLOWED_ANYTHINGLLM_HOSTS=jarvis.xperteam.net,anythingllm

# URL publiques suggérées (non secrètes — aussi configurables dans la console)
BOOKSTACK_BASE_URL=https://documentation.xperteam.net
ANYTHINGLLM_BASE_URL=https://jarvis.xperteam.net

# Secrets API optionnels via env (sinon saisie UI + coffre)
# BOOKSTACK_TOKEN_ID=
# BOOKSTACK_TOKEN_SECRET=
# ANYTHINGLLM_API_KEY=

# Coffre AES-256-GCM pour secrets saisis via la console — OBLIGATOIRE si UI secrets
# openssl rand -base64 32 — sauvegarder : perte = resaisie des tokens
# SECRETS_MASTER_KEY=
# SECRETS_FILE=data/secrets.enc

TZ=Europe/Paris
